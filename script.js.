function toggleLanguage() {
  currentLanguage = currentLanguage === "en" ? "te" : "en";
  updateLanguage();
}

function updateLanguage() {
  const content = translations[currentLanguage];

  document.documentElement.lang = currentLanguage;

  // Browser tab title and page description
  const pageTitle = document.getElementById("pageTitle");
  if (pageTitle) {
    pageTitle.textContent = content.pageTitle;
  }

  const pageDescription = document.getElementById("pageDescription");
  if (pageDescription) {
    pageDescription.setAttribute("content", content.pageDescription);
  }

  // Language switch button
  const languageButton = document.getElementById("languageButton");
  if (languageButton) {
    languageButton.textContent = content.languageButton;
  }

  // Elements using data-en and data-te attributes
  document.querySelectorAll("[data-en][data-te]").forEach(element => {
    const translatedText = element.getAttribute(
      currentLanguage === "en" ? "data-en" : "data-te"
    );

    if (translatedText !== null) {
      element.textContent = translatedText;
    }
  });

  // Navigation
  const navLinks = document.querySelectorAll(".main-nav a");
  const navKeys = Object.keys(content.nav);

  navLinks.forEach((link, index) => {
    if (navKeys[index]) {
      link.textContent = content.nav[navKeys[index]];
    }
  });

  // Section headings and labels
  setText(".breaking-label", content.breaking);
  setText(".breaking-text", content.breakingText);
  setText(".hero-label", content.heroLabel);
  setText(".hero-title", content.heroTitle);
  setText(".hero-description", content.heroDescription);
  setText(".hero-button", content.heroButton);
  setText(".top-stories-title", content.topStories);
  setText(".categories-title", content.categories);
  setText(".latest-articles-title", content.latestArticles);

  // Search controls
  const searchInput = document.getElementById("searchInput");
  if (searchInput) {
    searchInput.placeholder = content.searchPlaceholder;
  }

  const searchButton = document.getElementById("searchButton");
  if (searchButton) {
    searchButton.textContent = content.searchButton;
  }

  // Article cards
  const articleCards = document.querySelectorAll(".article-card");

  articleCards.forEach((card, index) => {
    const story = content.stories[index];

    if (!story) return;

    const category = card.querySelector(".article-category");
    const imageLabel = card.querySelector(".article-image");
    const title = card.querySelector(".article-title");
    const description = card.querySelector(".article-description");

    if (category) category.textContent = story.category;
    if (imageLabel) imageLabel.textContent = story.imageLabel;
    if (title) title.textContent = story.title;
    if (description) description.textContent = story.description;
  });

  // Footer copyright
  const copyrightText = document.getElementById("copyrightText");
  if (copyrightText) {
    copyrightText.textContent = content.copyright;
  }

  // Update category labels if present
  const categoryItems = document.querySelectorAll(".category-card");
  categoryItems.forEach((item, index) => {
    if (content.categoriesList[index]) {
      const label = item.querySelector(".category-title");
      if (label) {
        label.textContent = content.categoriesList[index];
      }
    }
  });

  // Reapply active search in the selected language
  const currentSearch = searchInput ? searchInput.value.trim() : "";
  if (currentSearch) {
    searchArticles();
  }
}

function setText(selector, value) {
  const element = document.querySelector(selector);
  if (element) {
    element.textContent = value;
  }
}

// Search functionality
function searchArticles() {
  const searchInput = document.getElementById("searchInput");

  if (!searchInput) return;

  const searchTerm = searchInput.value.trim().toLowerCase();
  const articleCards = document.querySelectorAll(".article-card");

  let visibleCount = 0;

  articleCards.forEach(card => {
    const cardText = card.textContent.toLowerCase();
    const matches = !searchTerm || cardText.includes(searchTerm);

    card.style.display = matches ? "" : "none";

    if (matches) {
      visibleCount++;
    }
  });

  // Display search feedback
  let message = document.getElementById("searchMessage");

  if (!message) {
    message = document.createElement("p");
    message.id = "searchMessage";

    const articleSection = document.querySelector(".latest-articles");

    if (articleSection) {
      articleSection.appendChild(message);
    }
  }

  if (message) {
    if (searchTerm && visibleCount === 0) {
      message.textContent = translations[currentLanguage].searchNoResults;
    } else if (searchTerm) {
      message.textContent =
        translations[currentLanguage].searchResults + ": " + visibleCount;
    } else {
      message.textContent = "";
    }
  }
}

// Search when Enter is pressed
document.addEventListener("DOMContentLoaded", function () {
  const searchInput = document.getElementById("searchInput");

  if (searchInput) {
    searchInput.addEventListener("keydown", function (event) {
      if (event.key === "Enter") {
        searchArticles();
      }
    });
  }

  updateLanguage();
});
