/* =================================
   UPDATE WEBSITE LANGUAGE
================================= */

function toggleLanguage() {

  currentLanguage = currentLanguage === "en" ? "te" : "en";

  updateLanguage();
}

function updateLanguage() {

  const content = translations[currentLanguage];

  const telugu = currentLanguage === "te";

  document.documentElement.lang = currentLanguage;

  function setText(id, value) {
    const element = document.getElementById(id);

    if (element) {
      element.textContent = value;
    }
  }

  setText("breakingLabel", content.breakingLabel);
  setText("breakingText", content.breakingText);

  setText("featuredTag", content.featuredTag);
  setText("heroTitle", content.heroTitle);
  setText("heroDescription", content.heroDescription);

  setText("topStoriesTitle", content.topStoriesTitle);
  setText("categoriesTitle", content.categoriesTitle);
  setText("latestTitle", content.latestTitle);

  setText("searchButton", content.searchButton);
  setText("footerText", content.footerText);

  const searchInput = document.getElementById("searchInput");

  if (searchInput) {
    searchInput.placeholder = content.searchPlaceholder;
    searchInput.setAttribute("aria-label", content.searchLabel);
  }

  /* Update navigation links */

  document.querySelectorAll(".main-nav a").forEach(link => {

    const translatedText = link.dataset[
      telugu ? "te" : "en"
    ];

    if (translatedText) {
      link.textContent = translatedText;
    }

  });

  /* Update category names */

  const categoryNames = telugu
    ? ["🇮🇳 భారతదేశం", "🌍 ప్రపంచం", "📊 వ్యాపారం",
       "💻 సాంకేతికత", "🎓 విద్య", "💡 జీవనశైలి"]
    : ["🇮🇳 India", "🌍 World", "📊 Business",
       "💻 Technology", "🎓 Education", "💡 Lifestyle"];

  document.querySelectorAll(".category").forEach((category, index) => {
    if (categoryNames[index]) {
      category.textContent = categoryNames[index];
    }
  });

  /* Update top stories */

  document.querySelectorAll(".side-story").forEach((story, index) => {

    const item = content.stories[index];

    if (!item) return;

    const category = story.querySelector("small");
    const title = story.querySelector("strong");

    if (category) {
      category.textContent = item.category || "";
    }

    if (title) {
      title.textContent = item.title || "";
    }

  });

  /* Update article cards */

  document.querySelectorAll(".article").forEach((article, index) => {

    const item = content.stories[index];

    if (!item) return;

    const category = article.querySelector(".article-content small");
    const title = article.querySelector(".article-content h3");
    const description = article.querySelector(".article-content p");

    if (category) {
      category.textContent = item.category || "";
    }

    if (title) {
      title.textContent = item.articleTitle || "";
    }

    if (description) {
      description.textContent = item.description || "";
    }

  });

  /* Refresh search results in the selected language */

  searchArticles();

}

/* =================================
   ARTICLE SEARCH
================================= */

function searchArticles() {

  const searchInput = document.getElementById("searchInput");

  if (!searchInput) return;

  const query = searchInput.value.trim().toLowerCase();

  const articles = document.querySelectorAll(".article");

  let found = 0;

  articles.forEach(article => {

    const matches = article.textContent
      .toLowerCase()
      .includes(query);

    article.style.display = matches ? "" : "none";

    if (matches) {
      found++;
    }

  });

  const message = document.getElementById("searchMessage");

  if (!message) return;

  if (query === "") {
    message.textContent = "";
  } else if (found === 0) {
    message.textContent = translations[currentLanguage].noArticles;
  } else if (found === 1) {
    message.textContent = "1 " +
      translations[currentLanguage].articleFound;
  } else {
    message.textContent = found + " " +
      translations[currentLanguage].articlesFound;
  }

}

/* =================================
   SEARCH WITH ENTER KEY
================================= */

const searchInput = document.getElementById("searchInput");

if (searchInput) {

  searchInput.addEventListener("keydown", function(event) {

    if (event.key === "Enter") {
      searchArticles();
    }

  });

}

/* =================================
   INITIAL WEBSITE SETUP
================================= */

